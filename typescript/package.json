		"./@langchain/weaviate": {
			"types": "./dist/ext/compat/langchain.d.ts",
			"default": "./dist/ext/compat/langchain.js"
		},
		"./@llamaindex/chroma": {
			"types": "./dist/ext/compat/llamaindex.d.ts",
			"default": "./dist/ext/compat/llamaindex.js"
		},
		"./@llamaindex/pinecone": {
			"types": "./dist/ext/compat/llamaindex.d.ts",
			"default": "./dist/ext/compat/llamaindex.js"
		},
		"./@llamaindex/qdrant": {
			"types": "./dist/ext/compat/llamaindex.d.ts",
			"default": "./dist/ext/compat/llamaindex.js"
		},
		"./@llamaindex/milvus": {
			"types": "./dist/ext/compat/llamaindex.d.ts",
			"default": "./dist/ext/compat/llamaindex.js"
		},
		"./@llamaindex/weaviate": {
			"types": "./dist/ext/compat/llamaindex.d.ts",
			"default": "./dist/ext/compat/llamaindex.js"
		},
		"./@langchain/community/vectorstores/chroma": {
			"types": "./dist/ext/compat/langchain.d.ts",
			"default": "./dist/ext/compat/langchain.js"
		},
		"./@langchain/community/vectorstores/pinecone": {
			"types": "./dist/ext/compat/langchain.d.ts",
			"default": "./dist/ext/compat/langchain.js"
		},
		"./@langchain/community/vectorstores/qdrant": {
			"types": "./dist/ext/compat/langchain.d.ts",
			"default": "./dist/ext/compat/langchain.js"
