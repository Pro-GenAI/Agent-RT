	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "npm run build && node --test tests/test.js tests/migration.test.js tests/migration_field.test.js tests/langchain.test.js tests/llamaindex.test.js tests/openai_agents.test.js tests/vector-mock-integration.test.js tests/decisions.test.js tests/evaluation.test.js tests/management_extensions.test.js tests/deployment.test.js tests/optimization.test.js tests/operations.test.js tests/review-regressions.test.js",
		"evaluate": "node scripts/evaluate-harness.js --scope all",
		"evaluate:evals": "node scripts/evaluate-harness.js --scope evals",
		"evaluate:tests": "node scripts/evaluate-harness.js --scope tests",
		"evaluate:benchmark": "node scripts/evaluate-harness.js --scope benchmark",
		"evaluate:performance": "node scripts/evaluate-harness.js --scope benchmark --benchmark performance",
		"security:scan": "node scripts/security-scan.mjs",
		"security:scan:gate": "node scripts/security-scan.mjs --fail-on medium",
		"security:attacks": "npm run build && node scripts/security-attack-scan.mjs",
		"security:gate": "npm run security:scan:gate && npm run security:attacks && npm run security:deps && npm run security:secrets && npm run security:mcp",
		"test:matrix": "bash scripts/test-matrix.sh",
		"lint": "eslint src scripts",
		"lint:fix": "eslint src scripts --fix",
		"format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.{js,mjs}\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.{js,mjs}\"",
		"quality:dead-code": "knip --include dependencies,unlisted,unresolved",
		"quality:check": "npm run typecheck && npm run lint && npm run quality:dead-code",
		"security:deps": "audit-ci --moderate",
		"security:secrets": "node scripts/security-secret-scan.mjs",
		"security:sbom": "node scripts/security-generate-sbom.mjs && npm run security:sbom:summary",
		"security:sbom:summary": "node scripts/security-sbom-summary.mjs sbom.cdx.json",
		"security:ai:static": "te-agent-security scan src --severity high",
		"security:mcp": "mcp-scan scan src --output text"
	},
	"license": "MIT",
	"files": [
		"dist",
		"README.md"
	],
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.128.0",
		"@copilotkit/aimock": "^1.43.0",
		"@empowered-humanity/agent-security": "^2.0.0",
		"@eslint/js": "^10.0.1",
		"@syntrophy/mcp-scan": "^0.1.0",
		"@types/ws": "^8.18.1",
		"audit-ci": "^7.1.0",
		"eslint": "^10.11.0",
		"eslint-plugin-security": "^4.1.0",
		"knip": "^6.38.0",
		"openai": "^6.49.0",
		"prettier": "^3.9.9",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.71.0"
	},
	"dependencies": {
		"ws": "^8.22.0"
	},
	"peerDependencies": {
		"@anthropic-ai/sdk": ">=0.14.0",
		"@traceloop/node-server-sdk": "^0.27.0",
		"agent-action-guard": "^1.2.1",
		"e2b": ">=1.4.0 <3",
		"microsandbox": ">=0.7.4 <0.8",
		"openai": ">=4.0.0"
	},
	"peerDependenciesMeta": {
		"@anthropic-ai/sdk": {
			"optional": true
		},
		"agent-action-guard": {
			"optional": true
		},
		"e2b": {
			"optional": true
		},
		"microsandbox": {
			"optional": true
		},
		"openai": {
			"optional": true
		},
		"@traceloop/node-server-sdk": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=20 <27"
	},
	"overrides": {
		"@empowered-humanity/agent-security": {
			"glob": "13.0.6"
		}
	}
}
