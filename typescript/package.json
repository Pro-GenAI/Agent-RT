		},
		"./openai": {
			"import": {
				"types": "./dist/ext/compat/openai_esm.d.mts",
				"default": "./dist/ext/compat/openai_esm.mjs"
			},
			"types": "./dist/ext/compat/openai.d.ts",
			"default": "./dist/ext/compat/openai.js"
		},
		"./anthropic": {
			"import": {
				"types": "./dist/ext/compat/anthropic_esm.d.mts",
