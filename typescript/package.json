		},
		"./@langchain/openai": {
			"types": "./dist/ext/compat/langchain.d.ts",
			"default": "./dist/ext/compat/langchain.js"
		},
		"./@langchain/anthropic": {
			"types": "./dist/ext/compat/langchain.d.ts",
			"default": "./dist/ext/compat/langchain.js"
		},
		"./@llamaindex/openai": {
			"types": "./dist/ext/compat/llamaindex.d.ts",
			"default": "./dist/ext/compat/llamaindex.js"
		},
		"./@llamaindex/anthropic": {
			"types": "./dist/ext/compat/llamaindex.d.ts",
			"default": "./dist/ext/compat/llamaindex.js"
		},
		"./@anthropic-ai/sdk": {
			"import": {
				"types": "./dist/ext/compat/anthropic_esm.d.mts",
				"default": "./dist/ext/compat/anthropic_esm.mjs"
			},
			"types": "./dist/ext/compat/anthropic.d.ts",
			"default": "./dist/ext/compat/anthropic.js"
		},
		"./@openai/agents": {
			"types": "./dist/ext/compat/openai_agents.d.ts",
			"default": "./dist/ext/compat/openai_agents.js"
		},
		"./openai-agents": {
			"types": "./dist/ext/compat/openai_agents.d.ts",
			"default": "./dist/ext/compat/openai_agents.js"
		},
		"./@langchain/chroma": {
			"types": "./dist/ext/compat/langchain.d.ts",
			"default": "./dist/ext/compat/langchain.js"
		},
		"./@langchain/pinecone": {
			"types": "./dist/ext/compat/langchain.d.ts",
			"default": "./dist/ext/compat/langchain.js"
