name: Cross-platform tests

on:
  pull_request:
  push:
    branches: [main]
  workflow_call:

permissions:
  contents: read

jobs:
  quality:
    name: Lint, format, and type checks
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.release.tag_name || github.sha }}
      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: npm
          cache-dependency-path: typescript/package-lock.json
      - name: Runtime module size limit (800 lines)
        run: python scripts/check_module_size.py
      - name: Install Python dependencies
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e "./python[dev]"
      - name: Python quality gate (mypy, Ruff, Black)
        working-directory: python
        run: |
          mypy src
          ruff check src tests scripts
          black --check src tests scripts
      - name: Install locked TypeScript dependencies
        working-directory: typescript
        run: npm ci
      - name: TypeScript quality gate (tsc, ESLint, Knip, Prettier)
        working-directory: typescript
        run: |
          npm run quality:check
          npm run format:check

  python:
    name: Python 3.13 / ${{ matrix.os }}
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        # ARM Linux covers the Raspberry Pi instruction-set architecture;
        # Pi memory/CPU-limited testing also runs in CircleCI.
        os: [ubuntu-latest, ubuntu-24.04-arm, macos-15, macos-15-intel, windows-latest]
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.release.tag_name || github.sha }}
      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
      - name: Install Python and test dependencies
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e "./python[dev]"
      - name: Test Python runtime
        working-directory: python
        run: python -m pytest -q
      - name: Enforce static security threshold
        working-directory: python
        run: python scripts/security_scan.py --fail-on medium
      - name: Verify offline adversarial controls
        working-directory: python
        run: python scripts/security_attack_scan.py

  typescript:
    name: Node 22 / ${{ matrix.os }}
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, ubuntu-24.04-arm, macos-15, macos-15-intel, windows-latest]
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.release.tag_name || github.sha }}
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: npm
          cache-dependency-path: typescript/package-lock.json
      - name: Install locked dependencies
        working-directory: typescript
        run: npm ci
      - name: Test TypeScript runtime
        working-directory: typescript
        run: npm test
      - name: Enforce deterministic security gates
        working-directory: typescript
        run: npm run security:scan:gate
      - name: Verify offline adversarial controls
        working-directory: typescript
        run: npm run security:attacks
